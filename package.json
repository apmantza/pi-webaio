{
	"name": "pi-webaio",
	"version": "1.0.5",
	"description": "All-in-one web tools for pi with search (Google, Brave, DDG, TinyFish, FireCrawl) and fetch with headless browser AI summarization, TinyFish Fetch, and FireCrawl Keyless Scrape",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/apmantza/pi-webaio.git"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"pi-package",
		"web-scraping",
		"web-fetch",
		"crawler",
		"markdown",
		"anti-bot",
		"tls-fingerprinting",
		"pdf-extraction",
		"duckduckgo",
		"brave",
		"google",
		"google-search",
		"ai-summarization",
		"headless-chrome",
		"cdp",
		"llm",
		"typescript"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./webfetch": {
			"types": "./dist/src/webfetch.d.ts",
			"import": "./dist/src/webfetch.js"
		}
	},
	"imports": {
		"#stealth-script": "./extractors/stealth-script.mjs"
	},
	"bin": {
		"pi-webaio-mcp": "bin/pi-webaio-mcp.mjs"
	},
	"pi": {
		"extensions": [
			"./pi-entry.mjs"
		]
	},
	"files": [
		"dist/",
		"bin/",
		"pi-entry.mjs",
		"extractors/",
		"scripts/bench-google-cdp.mjs",
		"package.json",
		"README.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"LICENSE",
		"docs/architecture.md",
		"docs/custom-verticals.md",
		"docs/features.md",
		"docs/mcp.md",
		"docs/tools.md",
		"docs/usage.md",
		"tsconfig.json"
	],
	"scripts": {
		"build": "tsc --project tsconfig.dist.json",
		"build:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.dist.json",
		"prepare": "node scripts/prepare.mjs",
		"lint": "tsc --project tsconfig.json",
		"watch": "tsc --watch",
		"test": "node --experimental-strip-types --test tests/unit.test.mjs",
		"test:startup": "node --experimental-strip-types --test tests/startup-lazy.test.mjs",
		"test:broker": "node --test tests/google-cdp-broker.test.mjs tests/google-cdp-broker-process.test.mjs tests/google-cdp-broker-cdp.test.mjs tests/google-cdp-broker-client.test.mjs tests/google-ai-broker.test.mjs",
		"test:mcp": "node --test tests/mcp-server.test.mjs",
		"test:integration": "node --experimental-strip-types --test tests/integration.test.mjs",
		"test:new": "node --experimental-strip-types --test tests/new-features.test.mjs",
		"test:paywall": "node --experimental-strip-types --test tests/paywall.test.mjs",
		"test:check": "node --experimental-strip-types --test tests/github-check.test.mjs",
		"test:render": "node --experimental-strip-types --test tests/render-result.test.mjs",
		"test:fetcherror": "node --experimental-strip-types --test tests/fetch-error.test.mjs",
		"test:fetchprogress": "node --experimental-strip-types --test tests/fetch-progress.test.mjs",
