		"test:stance": "node --experimental-strip-types --test tests/stance.test.mjs",
		"test:cookie-cache": "node --experimental-strip-types --test tests/cookie-cache.test.mjs",
		"test:title-extraction": "node --experimental-strip-types --test tests/title-extraction.test.mjs",
