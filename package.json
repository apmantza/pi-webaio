{
  "name": "pi-webaio",
  "version": "0.4.2",
  "description": "All-in-one web tools for pi with search (Google, Brave, DDG) and fetch with headless browser AI summarization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apmantza/pi-webaio.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "web-scraping",
    "web-fetch",
    "crawler",
    "markdown",
    "anti-bot",
    "tls-fingerprinting",
    "pdf-extraction",
    "duckduckgo",
    "brave",
    "google",
    "google-search",
    "ai-summarization",
    "headless-chrome",
    "cdp",
    "llm",
    "typescript"
  ],
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "banner.svg",
    "banner.png",
    "bin/",
    "extractors/",
    "src/",
    "types/",
    "tests/",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "npx tsx tests/unit.test.mjs",
    "test:integration": "npx tsx tests/integration.test.mjs",
    "test:new": "npx tsx tests/new-features.test.mjs",
    "test:paywall": "npx tsx tests/paywall.test.mjs",
    "test:check": "npx tsx tests/github-check.test.mjs",
    "test:render": "npx tsx tests/render-result.test.mjs",
    "test:fetcherror": "npx tsx tests/fetch-error.test.mjs",
    "test:fetchprogress": "npx tsx tests/fetch-progress.test.mjs",
    "test:hardening": "npx tsx tests/hardening.test.mjs",
    "test:format": "npx tsx tests/format.test.mjs",
    "test:all": "npx tsx tests/unit.test.mjs && npx tsx tests/new-features.test.mjs && npx tsx tests/paywall.test.mjs && npx tsx tests/github-check.test.mjs && npx tsx tests/render-result.test.mjs && npx tsx tests/fetch-error.test.mjs && npx tsx tests/fetch-progress.test.mjs && npx tsx tests/hardening.test.mjs && npx tsx tests/format.test.mjs && npx tsx tests/integration.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.74.2",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.18.1",
    "linkedom": "^0.18.12",
    "mathml-to-latex": "^1.5.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5",
    "temml": "^0.13.1",
    "turndown": "^7.2.0",
    "wreq-js": "^2.3.0",
    "youtube-transcript-plus": "^2.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typebox": "^1.1.34",
    "typescript": "^6.0.3"
  }
}
