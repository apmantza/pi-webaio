  "description": "All-in-one web access tools for pi with search, fetch, crawl, extraction, and anti-bot TLS fingerprinting",
  "license": "MIT",
  "repository": "github:apmantza/pi-webaio",
  "keywords": ["pi-package"],
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": ["./index.ts"]
