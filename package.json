		"@earendil-works/pi-coding-agent": "^0.83.0 || ^0.84.0",
		"@earendil-works/pi-tui": "^0.83.0 || ^0.84.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"overrides": {
		"protobufjs": "^7.6.5",
		"@hono/node-server": "^2.0.5"
	},
	"optionalDependencies": {
		"playwright": "^1.55.0"
	},
	"devDependencies": {
		"@earendil-works/pi-tui": "^0.83.0 || ^0.84.0",
